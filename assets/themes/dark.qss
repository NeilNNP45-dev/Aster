/* 🌼 Aster Sleek Dark Theme (QSS) */

QMainWindow, QDialog {
    background-color: #121214;
    color: #F3F4F6;
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
}

QWidget {
    color: #F3F4F6;
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    font-size: 14px;
}

/* --- Sidebar Styling --- */
#SidebarWidget {
    background-color: #1A1A1E;
    border-right: 1px solid #292932;
}

#SidebarLogo {
    font-size: 20px;
    font-weight: 700;
    color: #FFFFFF;
    padding: 16px 12px 20px 12px;
}

#SidebarLogoSpan {
    color: #A78BFA;
}

QPushButton.nav-btn {
    background-color: transparent;
    color: #9CA3AF;
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
}

QPushButton.nav-btn:hover {
    background-color: #26262E;
    color: #F3F4F6;
}

QPushButton.nav-btn:checked, QPushButton.nav-btn.active {
    background-color: #2E2544;
    color: #C4B5FD;
    font-weight: 600;
    border-left: 3px solid #8B5CF6;
}

/* --- Main Content Area & Pages --- */
#ContentArea, QStackedWidget {
    background-color: #121214;
}

#ProductivityPage, #CollegePage, #CodingPage, #FitnessPage, #AnalyticsPage, #SettingsPage, #HomePage,
#TasksWidget, #GoalsWidget, #NotesWidget, #PomodoroWidget,
#CoursesWidget, #TimetableWidget, #AttendanceWidget, #AssignmentsWidget, #ExamsWidget {
    background-color: #121214;
}

/* --- Global Scroll Areas & Container Viewports --- */
QScrollArea, QAbstractScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget, QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollArea QWidget#qt_scrollarea_viewport {
    background-color: transparent;
}

.page-container {
    background-color: #121214;
    padding: 24px;
}

.page-header {
    font-size: 24px;
    font-weight: 700;
    color: #F9FAFB;
    margin-bottom: 4px;
}

.page-subtitle {
    font-size: 14px;
    color: #9CA3AF;
    margin-bottom: 20px;
}

/* --- Card Widgets --- */
.card {
    background-color: #1E1E24;
    border: 1px solid #2D2D38;
    border-radius: 12px;
    padding: 20px;
}

.card-title {
    font-size: 16px;
    font-weight: 600;
    color: #E5E7EB;
    margin-bottom: 8px;
}

.card-description {
    font-size: 13px;
    color: #9CA3AF;
    line-height: 1.4;
}

.status-badge {
    background-color: #2E2842;
    color: #C4B5FD;
    border: 1px solid #4C3D74;
    border-radius: 12px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
    background: #121214;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #2D2D38;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #4B4B5A;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #121214;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #2D2D38;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* =========================================================
   VERSION 0.2 – PRODUCTIVITY UI STYLES
   ========================================================= */

/* --- Pill Sub-Tab Navigation --- */
QPushButton[class="pill-tab"] {
    background-color: transparent;
    color: #9CA3AF;
    border: 1px solid #2D2D38;
    border-radius: 20px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton[class="pill-tab"]:hover {
    background-color: #26262E;
    color: #E5E7EB;
}
QPushButton[class="pill-tab"]:checked {
    background-color: #2E2544;
    color: #C4B5FD;
    border-color: #6D28D9;
    font-weight: 600;
}

/* --- Primary / Secondary / Danger Buttons --- */
QPushButton[class="primary-btn"] {
    background-color: #7C3AED;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton[class="primary-btn"]:hover { background-color: #6D28D9; }
QPushButton[class="primary-btn"]:pressed { background-color: #5B21B6; }

QPushButton[class="secondary-btn"] {
    background-color: #26262E;
    color: #D1D5DB;
    border: 1px solid #3D3D4A;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton[class="secondary-btn"]:hover { background-color: #30303C; color: #F3F4F6; }

QPushButton[class="danger-btn"] {
    background-color: transparent;
    color: #EF4444;
    border: 1px solid #3D1515;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
}
QPushButton[class="danger-btn"]:hover { background-color: #2D1212; }

/* --- Task Items --- */
QFrame[class="task-item"] {
    background-color: #1E1E24;
    border: 1px solid #2D2D38;
    border-radius: 10px;
}
QFrame[class="task-item"]:hover { border-color: #3D3D50; background-color: #23232C; }

QPushButton[class="task-check-btn"] {
    background-color: transparent;
    color: transparent;
    border: 2px solid #4B4B5A;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 700;
}
QPushButton[class="task-check-btn"]:hover { border-color: #7C3AED; }
QPushButton[class="task-check-btn completed"] { background-color: #7C3AED; color: #FFFFFF; border-color: #7C3AED; }

QPushButton[class="task-delete-btn"] { background-color: transparent; color: #6B7280; border: none; border-radius: 4px; font-size: 11px; }
QPushButton[class="task-delete-btn"]:hover { color: #EF4444; background-color: #2D1212; }

QLabel[class="task-title"] { font-size: 14px; color: #E5E7EB; }
QLabel[class="task-due"] { font-size: 12px; color: #6B7280; }

/* --- Progress Bar (Habits) --- */
QProgressBar[class="habit-progress"] { background-color: #26262E; border: none; border-radius: 4px; }
QProgressBar[class="habit-progress"]::chunk { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #7C3AED, stop:1 #A78BFA); border-radius: 4px; }

/* --- Notes --- */
QListWidget[class="note-list"] { background-color: #1A1A1E; border: none; border-right: 1px solid #2D2D38; outline: none; padding: 8px 4px; }
QListWidget[class="note-list"]::item { color: #D1D5DB; padding: 10px 12px; border-radius: 8px; margin: 2px 4px; }
QListWidget[class="note-list"]::item:selected { background-color: #2E2544; color: #C4B5FD; }
QListWidget[class="note-list"]::item:hover:!selected { background-color: #26262E; }

QWidget[class="note-editor-panel"] { background-color: #121214; }

QLineEdit[class="note-title-input"] { background-color: transparent; border: none; border-bottom: 1px solid #2D2D38; color: #F9FAFB; font-size: 18px; font-weight: 600; padding: 8px 0px; }
QLineEdit[class="note-title-input"]:focus { border-bottom-color: #7C3AED; }

QTextEdit[class="note-body-editor"] { background-color: transparent; border: none; color: #D1D5DB; font-size: 14px; selection-background-color: #2E2544; }

/* --- Form Controls & Inputs --- */
QLineEdit[class="form-input"], QTextEdit[class="form-input"] {
    background-color: #1E1E24;
    border: 1px solid #2D2D38;
    border-radius: 8px;
    color: #F3F4F6;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #2E2544;
}
QLineEdit[class="form-input"]:focus, QTextEdit[class="form-input"]:focus { border-color: #7C3AED; }

QSpinBox, QDoubleSpinBox, QTimeEdit, QDateEdit, QDateTimeEdit,
QSpinBox[class="form-spinbox"], QDoubleSpinBox[class="form-spinbox"] {
    background-color: #1E1E24;
    border: 1px solid #2D2D38;
    border-radius: 8px;
    color: #F3F4F6;
    padding: 6px 10px;
    font-size: 13px;
    selection-background-color: #2E2544;
}
QSpinBox:focus, QDoubleSpinBox:focus, QTimeEdit:focus, QDateEdit:focus, QDateTimeEdit:focus {
    border-color: #7C3AED;
}
QSpinBox::up-button, QDoubleSpinBox::up-button, QTimeEdit::up-button, QDateEdit::up-button, QDateTimeEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #2D2D38;
    background-color: #262632;
    border-top-right-radius: 7px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button, QTimeEdit::down-button, QDateEdit::down-button, QDateTimeEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border-left: 1px solid #2D2D38;
    background-color: #262632;
    border-bottom-right-radius: 7px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover, QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #38384A;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow, QTimeEdit::up-arrow, QDateEdit::up-arrow, QDateTimeEdit::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #A78BFA;
    width: 0px;
    height: 0px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow, QTimeEdit::down-arrow, QDateEdit::down-arrow, QDateTimeEdit::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #A78BFA;
    width: 0px;
    height: 0px;
}

QFormLayout QLabel {
    color: #D1D5DB;
    font-size: 13px;
    font-weight: 500;
}


QComboBox {
    background-color: #1E1E24;
    border: 1px solid #2D2D38;
    border-radius: 8px;
    color: #F3F4F6;
    padding: 8px 12px;
    font-size: 13px;
}
QComboBox:focus {
    border-color: #7C3AED;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #2D2D38;
    background-color: #1E1E24;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #A78BFA;
    width: 0px;
    height: 0px;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: #1E1E24;
    border: 1px solid #3D3D50;
    color: #F3F4F6;
    selection-background-color: #2E2544;
    selection-color: #F3F4F6;
    outline: none;
}
QComboBox QAbstractItemView::item {
    padding: 8px 12px;
}

QComboBox[class="form-combo"] {
    background-color: #1E1E24;
    border: 1px solid #2D2D38;
    border-radius: 8px;
    color: #F3F4F6;
    padding: 8px 12px;
    font-size: 13px;
}
QComboBox[class="form-combo"]:focus {
    border-color: #7C3AED;
}
QComboBox[class="form-combo"]::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #2D2D38;
    background-color: #1E1E24;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}
QComboBox[class="form-combo"]::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #A78BFA;
    width: 0px;
    height: 0px;
    margin-right: 8px;
}
QComboBox[class="form-combo"] QAbstractItemView {
    background-color: #1E1E24;
    border: 1px solid #3D3D50;
    color: #F3F4F6;
    selection-background-color: #2E2544;
    selection-color: #F3F4F6;
    outline: none;
}
QComboBox[class="form-combo"] QAbstractItemView::item {
    padding: 8px 12px;
}

QCheckBox { color: #D1D5DB; font-size: 13px; spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 2px solid #4B4B5A; border-radius: 4px; background-color: transparent; }
QCheckBox::indicator:checked { background-color: #7C3AED; border-color: #7C3AED; }

QLineEdit[class="search-input"] { background-color: #1E1E24; border: 1px solid #2D2D38; border-radius: 20px; color: #F3F4F6; padding: 7px 14px; font-size: 13px; }
QLineEdit[class="search-input"]:focus { border-color: #7C3AED; }

/* --- Pomodoro --- */
QFrame[class="pomodoro-card"] { background-color: #1A1A20; border: 1px solid #2D2D38; border-radius: 20px; }
QLabel[class="pomodoro-timer"] { font-size: 72px; font-weight: 700; color: #F9FAFB; letter-spacing: 4px; }
QLabel[class="pomodoro-state-label"] { font-size: 16px; font-weight: 600; color: #A78BFA; letter-spacing: 1px; }
QPushButton[class="primary-btn pomodoro-play-btn"] { font-size: 15px; padding: 10px 32px; border-radius: 24px; }

QLabel[class="log-entry"] { font-size: 12px; color: #6B7280; padding: 4px 0px; border-bottom: 1px solid #1E1E24; }

/* --- Dialogs --- */
QDialog { background-color: #1A1A1E; }
QDialogButtonBox QPushButton { background-color: #26262E; color: #D1D5DB; border: 1px solid #3D3D4A; border-radius: 8px; padding: 7px 20px; font-size: 13px; min-width: 80px; }
QDialogButtonBox QPushButton:hover { background-color: #7C3AED; color: #FFFFFF; border-color: #7C3AED; }

/* --- Analytics Styles --- */
QFrame[class="stat-card"] { background-color: #1E1E24; border: 1px solid #2D2D38; border-radius: 12px; padding: 16px; }
QLabel[class="stat-number"] { font-size: 28px; font-weight: 700; color: #F9FAFB; }
QLabel[class="stat-label"] { font-size: 13px; font-weight: 500; color: #9CA3AF; }
QLabel[class="stat-badge-up"] { font-size: 11px; font-weight: 600; color: #34D399; background-color: #064E3B; border-radius: 4px; padding: 2px 6px; }
QLabel[class="stat-badge-down"] { font-size: 11px; font-weight: 600; color: #F87171; background-color: #7F1D1D; border-radius: 4px; padding: 2px 6px; }
QFrame[class="report-card"] { background-color: #191920; border: 1px solid #2D2D38; border-radius: 12px; padding: 20px; }
QLabel[class="report-header"] { font-size: 18px; font-weight: 700; color: #C4B5FD; margin-bottom: 8px; }
QLabel[class="report-subheader"] { font-size: 14px; font-weight: 600; color: #E5E7EB; margin-top: 12px; margin-bottom: 4px; }
QLabel[class="report-text"] { font-size: 13px; color: #D1D5DB; line-height: 1.5; }

/* --- Trend Charts --- */
QProgressBar[class="trend-progress"] {
    background-color: #26262E;
    border: 1px solid #2D2D38;
    border-radius: 7px;
}
QProgressBar[class="trend-progress"]::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7C3AED, stop:1 #C4B5FD);
    border-radius: 6px;
}
QFrame[class="trend-row"] {
    background-color: #1E1E24;
    border: 1px solid #2D2D38;
    border-radius: 8px;
    padding: 8px 12px;
}
QFrame[class="trend-row"]:hover {
    border-color: #3D3D50;
    background-color: #23232C;
}


