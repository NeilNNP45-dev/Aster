/* 🌼 Aster Sleek Dark Theme (QSS) */

QMainWindow, QDialog {
    background-color: #121214;
    color: #F3F4F6;
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
}

QWidget {
    color: #F3F4F6;
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    font-size: 14px;
}

/* --- Sidebar Styling --- */
#SidebarWidget {
    background-color: #1A1A1E;
    border-right: 1px solid #292932;
}

#SidebarLogo {
    font-size: 20px;
    font-weight: 700;
    color: #FFFFFF;
    padding: 16px 12px 20px 12px;
}

#SidebarLogoSpan {
    color: #A78BFA;
}

QPushButton.nav-btn {
    background-color: transparent;
    color: #9CA3AF;
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
}

QPushButton.nav-btn:hover {
    background-color: #26262E;
    color: #F3F4F6;
}

QPushButton.nav-btn:checked, QPushButton.nav-btn.active {
    background-color: #2E2544;
    color: #C4B5FD;
    font-weight: 600;
    border-left: 3px solid #8B5CF6;
}

/* --- Main Content Area & Pages --- */
#ContentArea, QStackedWidget {
    background-color: #121214;
}

#ProductivityPage, #CollegePage, #CodingPage, #FitnessPage, #AnalyticsPage, #SettingsPage, #HomePage,
#TasksWidget, #GoalsWidget, #NotesWidget, #PomodoroWidget,
#CoursesWidget, #TimetableWidget, #AttendanceWidget, #AssignmentsWidget, #ExamsWidget {
    background-color: #121214;
}

/* --- Global Scroll Areas & Container Viewports --- */
QScrollArea, QAbstractScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget, QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollArea QWidget#qt_scrollarea_viewport {
    background-color: transparent;
}

.page-container {
    background-color: #121214;
    padding: 24px;
}

.page-header {
    font-size: 24px;
    font-weight: 700;
    color: #F9FAFB;
    margin-bottom: 4px;
}

.page-subtitle {
    font-size: 14px;
    color: #9CA3AF;
    margin-bottom: 20px;
}

/* --- Card Widgets --- */
.card {
    background-color: #1E1E24;
    border: 1px solid #2D2D38;
    border-radius: 12px;
    padding: 20px;
}

.card-title {
    font-size: 16px;
    font-weight: 600;
    color: #E5E7EB;
    margin-bottom: 8px;
}

.card-description {
    font-size: 13px;
    color: #9CA3AF;
    line-height: 1.4;
}

.status-badge {
    background-color: #2E2842;
    color: #C4B5FD;
    border: 1px solid #4C3D74;
    border-radius: 12px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
    background: #121214;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #2D2D38;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #4B4B5A;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #121214;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #2D2D38;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* =========================================================
   VERSION 0.2 – PRODUCTIVITY UI STYLES
   ========================================================= */

/* --- Pill Sub-Tab Navigation --- */
QPushButton[class="pill-tab"] {
    background-color: transparent;
    color: #9CA3AF;
    border: 1px solid #2D2D38;
    border-radius: 20px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton[class="pill-tab"]:hover {
    background-color: #26262E;
    color: #E5E7EB;
}
QPushButton[class="pill-tab"]:checked {
    background-color: #2E2544;
    color: #C4B5FD;
    border-color: #6D28D9;
    font-weight: 600;
}

/* --- Primary / Secondary / Danger Buttons --- */
QPushButton[class="primary-btn"] {
    background-color: #7C3AED;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton[class="primary-btn"]:hover { background-color: #6D28D9; }
QPushButton[class="primary-btn"]:pressed { background-color: #5B21B6; }

QPushButton[class="secondary-btn"] {
    background-color: #26262E;
    color: #D1D5DB;
    border: 1px solid #3D3D4A;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton[class="secondary-btn"]:hover { background-color: #30303C; color: #F3F4F6; }

QPushButton[class="danger-btn"] {
    background-color: transparent;
    color: #EF4444;
    border: 1px solid #3D1515;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
}
QPushButton[class="danger-btn"]:hover { background-color: #2D1212; }

/* --- Task Items --- */
QFrame[class="task-item"] {
    background-color: #1E1E24;
    border: 1px solid #2D2D38;
    border-radius: 10px;
}
QFrame[class="task-item"]:hover { border-color: #3D3D50; background-color: #23232C; }

QPushButton[class="task-check-btn"] {
    background-color: transparent;
    color: transparent;
    border: 2px solid #4B4B5A;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 700;
}
QPushButton[class="task-check-btn"]:hover { border-color: #7C3AED; }
QPushButton[class="task-check-btn completed"] { background-color: #7C3AED; color: #FFFFFF; border-color: #7C3AED; }

QPushButton[class="task-delete-btn"] { background-color: transparent; color: #6B7280; border: none; border-radius: 4px; font-size: 11px; }
QPushButton[class="task-delete-btn"]:hover { color: #EF4444; background-color: #2D1212; }

QLabel[class="task-title"] { font-size: 14px; color: #E5E7EB; }
QLabel[class="task-due"] { font-size: 12px; color: #6B7280; }

/* --- Progress Bar (Habits) --- */
QProgressBar[class="habit-progress"] { background-color: #26262E; border: none; border-radius: 4px; }
QProgressBar[class="habit-progress"]::chunk { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #7C3AED, stop:1 #A78BFA); border-radius: 4px; }

/* --- Notes --- */
QListWidget[class="note-list"] { background-color: #1A1A1E; border: none; border-right: 1px solid #2D2D38; outline: none; padding: 8px 4px; }
QListWidget[class="note-list"]::item { color: #D1D5DB; padding: 10px 12px; border-radius: 8px; margin: 2px 4px; }
QListWidget[class="note-list"]::item:selected { background-color: #2E2544; color: #C4B5FD; }
QListWidget[class="note-list"]::item:hover:!selected { background-color: #26262E; }

QWidget[class="note-editor-panel"] { background-color: #121214; }

QLineEdit[class="note-title-input"] { background-color: transparent; border: none; border-bottom: 1px solid #2D2D38; color: #F9FAFB; font-size: 18px; font-weight: 600; padding: 8px 0px; }
QLineEdit[class="note-title-input"]:focus { border-bottom-color: #7C3AED; }

QTextEdit[class="note-body-editor"] { background-color: transparent; border: none; color: #D1D5DB; font-size: 14px; selection-background-color: #2E2544; }

/* --- Form Controls & Inputs --- */
QLineEdit[class="form-input"], QTextEdit[class="form-input"] {
    background-color: #1E1E24;
    border: 1px solid #2D2D38;
    border-radius: 8px;
    color: #F3F4F6;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #2E2544;
}
QLineEdit[class="form-input"]:focus, QTextEdit[class="form-input"]:focus { border-color: #7C3AED; }

QSpinBox, QDoubleSpinBox, QTimeEdit, QDateEdit, QDateTimeEdit,
QSpinBox[class="form-spinbox"], QDoubleSpinBox[class="form-spinbox"] {
    background-color: #1E1E24;
    border: 1px solid #2D2D38;
    border-radius: 8px;
    color: #F3F4F6;
    padding: 6px 10px;
    font-size: 13px;
    selection-background-color: #2E2544;
}
QSpinBox:focus, QDoubleSpinBox:focus, QTimeEdit:focus, QDateEdit:focus, QDateTimeEdit:focus {
    border-color: #7C3AED;
}
QSpinBox::up-button, QDoubleSpinBox::up-button, QTimeEdit::up-button, QDateEdit::up-button, QDateTimeEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #2D2D38;
    background-color: #262632;
    border-top-right-radius: 7px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button, QTimeEdit::down-button, QDateEdit::down-button, QDateTimeEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border-left: 1px solid #2D2D38;
    background-color: #262632;
    border-bottom-right-radius: 7px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover, QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #38384A;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow, QTimeEdit::up-arrow, QDateEdit::up-arrow, QDateTimeEdit::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #A78BFA;
    width: 0px;
    height: 0px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow, QTimeEdit::down-arrow, QDateEdit::down-arrow, QDateTimeEdit::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #A78BFA;
    width: 0px;
    height: 0px;
}

QFormLayout QLabel {
    color: #D1D5DB;
    font-size: 13px;
    font-weight: 500;
}


QComboBox {
    background-color: #1E1E24;
    border: 1px solid #2D2D38;
    border-radius: 8px;
    color: #F3F4F6;
    padding: 8px 12px;
    font-size: 13px;
}
QComboBox:focus {
    border-color: #7C3AED;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #2D2D38;
    background-color: #1E1E24;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #A78BFA;
    width: 0px;
    height: 0px;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: #1E1E24;
    border: 1px solid #3D3D50;
    color: #F3F4F6;
    selection-background-color: #2E2544;
    selection-color: #F3F4F6;
    outline: none;
}
QComboBox QAbstractItemView::item {
    padding: 8px 12px;
}

QComboBox[class="form-combo"] {
    background-color: #1E1E24;
    border: 1px solid #2D2D38;
    border-radius: 8px;
    color: #F3F4F6;
    padding: 8px 12px;
    font-size: 13px;
}
QComboBox[class="form-combo"]:focus {
    border-color: #7C3AED;
}
QComboBox[class="form-combo"]::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #2D2D38;
    background-color: #1E1E24;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}
QComboBox[class="form-combo"]::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #A78BFA;
    width: 0px;
    height: 0px;
    margin-right: 8px;
}
QComboBox[class="form-combo"] QAbstractItemView {
    background-color: #1E1E24;
    border: 1px solid #3D3D50;
    color: #F3F4F6;
    selection-background-color: #2E2544;
    selection-color: #F3F4F6;
    outline: none;
}
QComboBox[class="form-combo"] QAbstractItemView::item {
    padding: 8px 12px;
}

QCheckBox { color: #D1D5DB; font-size: 13px; spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 2px solid #4B4B5A; border-radius: 4px; background-color: transparent; }
QCheckBox::indicator:checked { background-color: #7C3AED; border-color: #7C3AED; }

QLineEdit[class="search-input"] { background-color: #1E1E24; border: 1px solid #2D2D38; border-radius: 20px; color: #F3F4F6; padding: 7px 14px; font-size: 13px; }
QLineEdit[class="search-input"]:focus { border-color: #7C3AED; }

/* --- Pomodoro --- */
QFrame[class="pomodoro-card"] { background-color: #1A1A20; border: 1px solid #2D2D38; border-radius: 20px; }
QFrame[class="pomodoro-display"] { background-color: #121214; border: 1px solid #2D2D38; border-radius: 16px; }
QFrame[class="pomodoro-mode-selector"] { background-color: transparent; }
QLabel[class="pomodoro-timer"] { font-size: 72px; font-weight: 700; color: #F9FAFB; letter-spacing: 4px; }
QLabel[class="pomodoro-state-label"] { font-size: 16px; font-weight: 600; color: #A78BFA; letter-spacing: 1px; }
QPushButton[class="primary-btn pomodoro-play-btn"] { font-size: 15px; padding: 10px 32px; border-radius: 24px; }
QPushButton[class="secondary-btn pomodoro-settings-btn"] { padding: 6px 12px; font-size: 12px; }

QLabel[class="log-entry"] { font-size: 12px; color: #6B7280; padding: 4px 0px; border-bottom: 1px solid #1E1E24; }

/* --- Dialogs --- */
QDialog { background-color: #1A1A1E; }
QDialogButtonBox QPushButton { background-color: #26262E; color: #D1D5DB; border: 1px solid #3D3D4A; border-radius: 8px; padding: 7px 20px; font-size: 13px; min-width: 80px; }
QDialogButtonBox QPushButton:hover { background-color: #7C3AED; color: #FFFFFF; border-color: #7C3AED; }

/* --- Analytics Styles --- */
QFrame[class="stat-card"] { background-color: #1E1E24; border: 1px solid #2D2D38; border-radius: 12px; padding: 16px; }
QLabel[class="stat-number"] { font-size: 28px; font-weight: 700; color: #F9FAFB; }
QLabel[class="stat-label"] { font-size: 13px; font-weight: 500; color: #9CA3AF; }
QLabel[class="stat-badge-up"] { font-size: 11px; font-weight: 600; color: #34D399; background-color: #064E3B; border-radius: 4px; padding: 2px 6px; }
QLabel[class="stat-badge-down"] { font-size: 11px; font-weight: 600; color: #F87171; background-color: #7F1D1D; border-radius: 4px; padding: 2px 6px; }
QFrame[class="report-card"] { background-color: #191920; border: 1px solid #2D2D38; border-radius: 12px; padding: 20px; }
QLabel[class="report-header"] { font-size: 18px; font-weight: 700; color: #C4B5FD; margin-bottom: 8px; }
QLabel[class="report-subheader"] { font-size: 14px; font-weight: 600; color: #E5E7EB; margin-top: 12px; margin-bottom: 4px; }
QLabel[class="report-text"] { font-size: 13px; color: #D1D5DB; line-height: 1.5; }

/* --- Trend Charts --- */
QProgressBar[class="trend-progress"] {
    background-color: #26262E;
    border: 1px solid #2D2D38;
    border-radius: 7px;
}
QProgressBar[class="trend-progress"]::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7C3AED, stop:1 #C4B5FD);
    border-radius: 6px;
}
QFrame[class="trend-row"] {
    background-color: #1E1E24;
    border: 1px solid #2D2D38;
    border-radius: 8px;
    padding: 8px 12px;
}
QFrame[class="trend-row"]:hover {
    border-color: #3D3D50;
    background-color: #23232C;
}

/* --- Home & Settings Dashboard Enhancement Styles --- */
QFrame[class="metric-card"] {
    background-color: #1E1E24;
    border: 1px solid #2D2D38;
    border-radius: 12px;
    padding: 16px;
}
QFrame[class="metric-card"]:hover {
    border-color: #3D3D50;
    background-color: #22222B;
}

QLabel[class="metric-number"] {
    font-size: 26px;
    font-weight: 700;
    color: #F9FAFB;
}

QLabel[class="metric-label"] {
    font-size: 13px;
    font-weight: 500;
    color: #9CA3AF;
}

QPushButton[class="action-shortcut-btn"] {
    background-color: #1E1E24;
    color: #E5E7EB;
    border: 1px solid #2D2D38;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
}
QPushButton[class="action-shortcut-btn"]:hover {
    background-color: #2A2A36;
    border-color: #7C3AED;
    color: #FFFFFF;
}

QFrame[class="setting-card"] {
    background-color: #1E1E24;
    border: 1px solid #2D2D38;
    border-radius: 12px;
    padding: 18px;
}

QLabel[class="setting-key"] {
    font-size: 13px;
    font-weight: 600;
    color: #9CA3AF;
}

QLabel[class="setting-val"] {
    font-size: 13px;
    font-weight: 500;
    color: #F3F4F6;
}

QLabel[class="setting-val-highlight"] {
    font-size: 13px;
    font-weight: 600;
    color: #C4B5FD;
}


/* =========================================================
   ASTER WARM CANDY TWILIGHT PALETTE
   =========================================================
   A warmer, softer palette layered over the existing component
   vocabulary so the theme can evolve without changing behavior.
*/

QMainWindow, QDialog {
    background-color: #211B26;
    color: #FFF7FA;
}

QWidget {
    color: #FFF7FA;
}

#SidebarWidget {
    background-color: #2B2232;
    border-right: 1px solid #49374F;
}

#SidebarLogo {
    color: #FFF7FA;
}

#SidebarLogoSpan {
    color: #F3A6C7;
}

QPushButton.nav-btn {
    color: #C7B8C9;
}

QPushButton.nav-btn:hover {
    background-color: #3A2D42;
    color: #FFF7FA;
}

QPushButton.nav-btn:checked,
QPushButton.nav-btn.active {
    background-color: #493451;
    color: #E5C8FF;
    border-left-color: #C8A7F5;
}

#ContentArea, QStackedWidget,
#ProductivityPage, #CollegePage, #CodingPage, #FitnessPage,
#AnalyticsPage, #SettingsPage, #HomePage,
#TasksWidget, #GoalsWidget, #NotesWidget, #PomodoroWidget,
#CoursesWidget, #TimetableWidget, #AttendanceWidget,
#AssignmentsWidget, #ExamsWidget,
.page-container, QWidget[class="note-editor-panel"] {
    background-color: #211B26;
}

.page-header {
    color: #FFF7FA;
}

.page-subtitle,
.card-description,
QLabel[class="metric-label"],
QLabel[class="stat-label"],
QLabel[class="setting-key"] {
    color: #C7B8C9;
}

.card,
QFrame[class="metric-card"],
QFrame[class="stat-card"],
QFrame[class="task-item"],
QFrame[class="trend-row"],
QFrame[class="setting-card"] {
    background-color: #352A3D;
    border-color: #51405A;
}

.card:hover,
QFrame[class="metric-card"]:hover,
QFrame[class="task-item"]:hover,
QFrame[class="trend-row"]:hover {
    background-color: #3D3047;
    border-color: #80668B;
}

.card-title,
QLabel[class="task-title"],
QLabel[class="report-subheader"] {
    color: #FBEAF3;
}

.status-badge,
QPushButton[class="pill-tab"]:checked,
QListWidget[class="note-list"]::item:selected {
    background-color: #493451;
    color: #E5C8FF;
    border-color: #80668B;
}

QPushButton[class="pill-tab"] {
    color: #C7B8C9;
    border-color: #51405A;
}

QPushButton[class="pill-tab"]:hover,
QPushButton[class="secondary-btn"]:hover,
QPushButton[class="action-shortcut-btn"]:hover {
    background-color: #493451;
    color: #FFF7FA;
}

QPushButton[class="primary-btn"] {
    background-color: #F0A8C6;
    color: #351F2C;
}

QPushButton[class="primary-btn"]:hover {
    background-color: #F6B58E;
}

QPushButton[class="primary-btn"]:pressed {
    background-color: #D989AF;
}

QPushButton[class="secondary-btn"],
QPushButton[class="action-shortcut-btn"],
QDialogButtonBox QPushButton {
    background-color: #3A2D42;
    color: #FBEAF3;
    border-color: #665071;
}

QPushButton[class="danger-btn"] {
    color: #FF9FAD;
    border-color: #75434F;
}

QPushButton[class="danger-btn"]:hover,
QPushButton[class="task-delete-btn"]:hover {
    color: #FFF7FA;
    background-color: #57313F;
}

QPushButton[class="task-check-btn"] {
    border-color: #80668B;
}

QPushButton[class="task-check-btn"]:hover,
QPushButton[class="task-check-btn completed"] {
    background-color: #A8DEC5;
    border-color: #A8DEC5;
    color: #24382F;
}

QLabel[class="task-due"],
QLabel[class="log-entry"] {
    color: #B09EBA;
}

QProgressBar[class="habit-progress"],
QProgressBar[class="trend-progress"] {
    background-color: #2B2232;
    border-color: #51405A;
}

QProgressBar[class="habit-progress"]::chunk,
QProgressBar[class="trend-progress"]::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #C8A7F5, stop:0.55 #F3A6C7, stop:1 #A8DEC5);
}

QListWidget[class="note-list"] {
    background-color: #2B2232;
    border-right-color: #51405A;
}

QListWidget[class="note-list"]::item {
    color: #F0DFE9;
}

QListWidget[class="note-list"]::item:hover:!selected {
    background-color: #3A2D42;
}

QLineEdit[class="form-input"],
QTextEdit[class="form-input"],
QLineEdit[class="search-input"],
QSpinBox, QDoubleSpinBox, QTimeEdit, QDateEdit, QDateTimeEdit,
QSpinBox[class="form-spinbox"], QDoubleSpinBox[class="form-spinbox"],
QComboBox, QComboBox[class="form-combo"] {
    background-color: #302638;
    border-color: #51405A;
    color: #FFF7FA;
    selection-background-color: #6C4F78;
}

QLineEdit[class="form-input"]:focus,
QTextEdit[class="form-input"]:focus,
QLineEdit[class="search-input"]:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QTimeEdit:focus,
QDateEdit:focus, QDateTimeEdit:focus,
QComboBox:focus, QComboBox[class="form-combo"]:focus {
    border-color: #C8A7F5;
}

QComboBox QAbstractItemView,
QComboBox[class="form-combo"] QAbstractItemView {
    background-color: #302638;
    border-color: #80668B;
    color: #FFF7FA;
    selection-background-color: #6C4F78;
}

QCheckBox {
    color: #F0DFE9;
}

QCheckBox::indicator {
    border-color: #80668B;
}

QCheckBox::indicator:checked {
    background-color: #A8DEC5;
    border-color: #A8DEC5;
}

QFrame[class="pomodoro-card"] {
    background-color: #302638;
    border-color: #665071;
}

QFrame[class="pomodoro-display"] {
    background-color: #211B26;
    border-color: #51405A;
}

QLabel[class="pomodoro-timer"],
QLabel[class="stat-number"],
QLabel[class="metric-number"] {
    color: #FFF7FA;
}

QLabel[class="pomodoro-state-label"],
QLabel[class="report-header"],
QLabel[class="setting-val-highlight"] {
    color: #E5C8FF;
}

QFrame[class="report-card"] {
    background-color: #302638;
    border-color: #51405A;
}

QLabel[class="stat-badge-up"] {
    color: #BDF0D7;
    background-color: #315646;
}

QLabel[class="stat-badge-down"] {
    color: #FFD1D8;
    background-color: #663945;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: #211B26;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #665071;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #987CAD;
}

QDialog {
    background-color: #2B2232;
}


/* =========================================================
   ASTER SUNLIT CANDY PALETTE
   =========================================================
   Bright, playful, and warm: cream surfaces with coral,
   bubblegum pink, mint, sky blue, and sunny yellow accents.
*/

QMainWindow, QDialog,
QWidget,
#ContentArea, QStackedWidget,
#ProductivityPage, #CollegePage, #CodingPage, #FitnessPage,
#AnalyticsPage, #SettingsPage, #HomePage,
#TasksWidget, #GoalsWidget, #NotesWidget, #PomodoroWidget,
#CoursesWidget, #TimetableWidget, #AttendanceWidget,
#AssignmentsWidget, #ExamsWidget,
.page-container, QWidget[class="note-editor-panel"] {
    background-color: #FFF8F0;
    color: #3C3040;
}

#SidebarWidget {
    background-color: #FFF0F5;
    border-right-color: #F3D3DD;
}

#SidebarLogo {
    color: #3C3040;
}

#SidebarLogoSpan {
    color: #FF7F6E;
}

QPushButton.nav-btn {
    color: #8A6E7B;
}

QPushButton.nav-btn:hover {
    background-color: #FFE1E8;
    color: #3C3040;
}

QPushButton.nav-btn:checked,
QPushButton.nav-btn.active {
    background-color: #FFD6E2;
    color: #A84868;
    border-left-color: #FF7F6E;
}

.page-header {
    color: #3C3040;
}

.page-subtitle,
.card-description,
QLabel[class="metric-label"],
QLabel[class="stat-label"],
QLabel[class="setting-key"] {
    color: #8A6E7B;
}

.card,
QFrame[class="metric-card"],
QFrame[class="stat-card"],
QFrame[class="task-item"],
QFrame[class="trend-row"],
QFrame[class="setting-card"] {
    background-color: #FFFFFF;
    border-color: #F0DAD2;
}

.card:hover,
QFrame[class="metric-card"]:hover,
QFrame[class="task-item"]:hover,
QFrame[class="trend-row"]:hover {
    background-color: #FFFDF9;
    border-color: #F2B9A9;
}

.card-title,
QLabel[class="task-title"],
QLabel[class="report-subheader"] {
    color: #4A3744;
}

.status-badge,
QPushButton[class="pill-tab"]:checked,
QListWidget[class="note-list"]::item:selected {
    background-color: #FFE2A8;
    color: #79552A;
    border-color: #F0C56A;
}

QPushButton[class="pill-tab"] {
    color: #8A6E7B;
    border-color: #E8CFC7;
}

QPushButton[class="pill-tab"]:hover,
QPushButton[class="secondary-btn"]:hover,
QPushButton[class="action-shortcut-btn"]:hover {
    background-color: #FFF0D6;
    color: #4A3744;
}

QPushButton[class="primary-btn"] {
    background-color: #FF7F6E;
    color: #FFFFFF;
}

QPushButton[class="primary-btn"]:hover {
    background-color: #FF9B7A;
}

QPushButton[class="primary-btn"]:pressed {
    background-color: #E96862;
}

QPushButton[class="secondary-btn"],
QPushButton[class="action-shortcut-btn"],
QDialogButtonBox QPushButton {
    background-color: #FFF0D6;
    color: #6F4D42;
    border-color: #EBC9A7;
}

QPushButton[class="danger-btn"] {
    color: #D95767;
    border-color: #F0B7BE;
}

QPushButton[class="danger-btn"]:hover,
QPushButton[class="task-delete-btn"]:hover {
    color: #A83B4A;
    background-color: #FFE2E5;
}

QPushButton[class="task-check-btn"] {
    border-color: #B8D9CF;
}

QPushButton[class="task-check-btn"]:hover,
QPushButton[class="task-check-btn completed"] {
    background-color: #8ED8B5;
    border-color: #8ED8B5;
    color: #24533D;
}

QLabel[class="task-due"],
QLabel[class="log-entry"] {
    color: #A48591;
}

QProgressBar[class="habit-progress"],
QProgressBar[class="trend-progress"] {
    background-color: #F7E9E2;
    border-color: #F0DAD2;
}

QProgressBar[class="habit-progress"]::chunk,
QProgressBar[class="trend-progress"]::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #FF7F6E, stop:0.5 #F7A8C4, stop:1 #8FCBFF);
}

QListWidget[class="note-list"] {
    background-color: #FFF7F2;
    border-right-color: #F0DAD2;
}

QListWidget[class="note-list"]::item {
    color: #5B4652;
}

QListWidget[class="note-list"]::item:hover:!selected {
    background-color: #FFEAF0;
}

QLineEdit[class="form-input"],
QTextEdit[class="form-input"],
QLineEdit[class="search-input"],
QSpinBox, QDoubleSpinBox, QTimeEdit, QDateEdit, QDateTimeEdit,
QSpinBox[class="form-spinbox"], QDoubleSpinBox[class="form-spinbox"],
QComboBox, QComboBox[class="form-combo"] {
    background-color: #FFFFFF;
    border-color: #E8CFC7;
    color: #3C3040;
    selection-background-color: #FFC9D8;
}

QLineEdit[class="form-input"]:focus,
QTextEdit[class="form-input"]:focus,
QLineEdit[class="search-input"]:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QTimeEdit:focus,
QDateEdit:focus, QDateTimeEdit:focus,
QComboBox:focus, QComboBox[class="form-combo"]:focus {
    border-color: #FF9B7A;
}

QComboBox QAbstractItemView,
QComboBox[class="form-combo"] QAbstractItemView {
    background-color: #FFFFFF;
    border-color: #E8CFC7;
    color: #3C3040;
    selection-background-color: #FFC9D8;
}

QCheckBox {
    color: #5B4652;
}

QCheckBox::indicator {
    border-color: #B8D9CF;
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #8ED8B5;
    border-color: #8ED8B5;
}

QFrame[class="pomodoro-card"] {
    background-color: #FFF0D6;
    border-color: #F0C56A;
}

QFrame[class="pomodoro-display"] {
    background-color: #FFF8F0;
    border-color: #E8CFC7;
}

QLabel[class="pomodoro-timer"],
QLabel[class="stat-number"],
QLabel[class="metric-number"] {
    color: #3C3040;
}

QLabel[class="pomodoro-state-label"],
QLabel[class="report-header"],
QLabel[class="setting-val-highlight"] {
    color: #D85D78;
}

QFrame[class="report-card"] {
    background-color: #EEF8FF;
    border-color: #BBDDF4;
}

QLabel[class="stat-badge-up"] {
    color: #287051;
    background-color: #D8F4E6;
}

QLabel[class="stat-badge-down"] {
    color: #A83B4A;
    background-color: #FFE2E5;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: #FFF8F0;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #F0B7A8;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #FF9B7A;
}

QDialog {
    background-color: #FFF7F2;
}

/* Final readability and control-color corrections */

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow,
QTimeEdit::up-arrow, QDateEdit::up-arrow,
QDateTimeEdit::up-arrow {
    border-bottom-color: #FF7F6E;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow,
QTimeEdit::down-arrow, QDateEdit::down-arrow,
QDateTimeEdit::down-arrow {
    border-top-color: #FF7F6E;
}

QComboBox::down-arrow,
QComboBox[class="form-combo"]::down-arrow {
    border-top-color: #FF7F6E;
}

QLabel[class="report-text"] {
    color: #6F5963;
}

QLabel[class="report-subheader"] {
    color: #4A3744;
}


